datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("category")
}

model Product {
  id             String      @id @default(uuid())
  name_id        String
  name_en        String
  slug           String      @unique
  description_id String      @db.Text
  description_en String      @db.Text
  price          Decimal     @db.Decimal(12, 2)
  originalPrice  Decimal?    @db.Decimal(12, 2)
  stock          Int?        @default(0)
  imageUrl       String?     @db.LongText
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("product")
}

model Service {
  id             String   @id @default(uuid())
  name_id        String
  name_en        String
  slug           String   @unique
  description_id String   @db.Text
  description_en String   @db.Text
  price          Decimal  @db.Decimal(12, 2)
  originalPrice  Decimal? @db.Decimal(12, 2)
  features_id    String?  @db.Text
  features_en    String?  @db.Text
  type           String   @default("SHARPENING")
  imageUrl       String?  @db.LongText
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("service")
}

model Training {
  id              String   @id @default(uuid())
  title_id        String
  title_en        String
  slug            String   @unique
  description_id  String   @db.Text
  description_en  String   @db.Text
  price           Decimal  @db.Decimal(12, 2)
  date            DateTime
  location        String
  capacity        Int
  registeredCount Int      @default(0)
  imageUrl        String?  @db.LongText
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("training")
}

model Order {
  id              String      @id @default(uuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  totalAmount     Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(PENDING)
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String      @db.Text
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("order")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)

  @@map("orderitem")
}

model Portfolio {
  id             String   @id @default(uuid())
  title_id       String
  title_en       String
  slug           String   @unique
  description_id String   @db.Text
  description_en String   @db.Text
  imageUrl       String   @db.LongText
  category_id    String
  category_en    String
  metric_id      String?  @db.VarChar(200)
  metric_en      String?  @db.VarChar(200)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("portfolio")
}

model ActivityLog {
  id          String   @id @default(uuid())
  admin       String
  role        String   @default("ADMIN")
  module      String   @default("System")
  action      String
  description String   @db.Text
  ip          String
  createdAt   DateTime @default(now())

  @@map("activitylog")
}

model VisitorLog {
  id        String   @id @default(uuid())
  device    String
  ip        String
  page      String   @default("/")
  userAgent String?  @db.Text
  location  String   @default("Surabaya, ID")
  createdAt DateTime @default(now())

  @@map("visitorlog")
}

model SiteSettings {
  id              String   @id @default("default")
  logoText        String   @default("PADI SHARPENING")
  logoUrl         String?  @db.LongText
  
  // Hero Animation Asset
  heroAnimationUrl String? @db.LongText

  heroTitle_id    String?  @db.Text
  heroTitle_en    String?  @db.Text
  heroSubtitle_id String?  @db.Text
  heroSubtitle_en String?  @db.Text
  
  // Stats
  stat1Value      String?  @db.VarChar(100)
  stat1Label_id   String?  @db.VarChar(200)
  stat1Label_en   String?  @db.VarChar(200)
  stat2Value      String?  @db.VarChar(100)
  stat2Label_id   String?  @db.VarChar(200)
  stat2Label_en   String?  @db.VarChar(200)

  // Maps
  mapsEmbedUrl    String?  @db.Text

  // About Page (Siapa Kami)
  aboutTitle_id   String?  @db.VarChar(500)
  aboutTitle_en   String?  @db.VarChar(500)
  aboutDesc1_id   String?  @db.Text
  aboutDesc1_en   String?  @db.Text
  aboutDesc2_id   String?  @db.Text
  aboutDesc2_en   String?  @db.Text

  // 3 Feature Cards
  feature1Title_id String? @db.VarChar(200)
  feature1Title_en String? @db.VarChar(200)
  feature1Desc_id  String? @db.Text
  feature1Desc_en  String? @db.Text

  feature2Title_id String? @db.VarChar(200)
  feature2Title_en String? @db.VarChar(200)
  feature2Desc_id  String? @db.Text
  feature2Desc_en  String? @db.Text

  feature3Title_id String? @db.VarChar(200)
  feature3Title_en String? @db.VarChar(200)
  feature3Desc_id  String? @db.Text
  feature3Desc_en  String? @db.Text

  // Footer & Contact
  footerDesc_id    String? @db.Text
  footerDesc_en    String? @db.Text
  footerAddress    String? @db.Text
  footerPhone      String? @db.VarChar(100)
  footerEmail      String? @db.VarChar(200)
  footerCoordinates String? @db.VarChar(200)
  footerCopyright_id String? @db.VarChar(500)
  footerCopyright_en String? @db.VarChar(500)
  footerBrand        String? @db.VarChar(300)
  workingHours_id    String? @db.VarChar(200)
  workingHours_en    String? @db.VarChar(200)

  // Services Page Headings
  servicesTitle_id        String? @db.VarChar(500)
  servicesTitle_en        String? @db.VarChar(500)
  servicesSubtitle_id     String? @db.Text
  servicesSubtitle_en     String? @db.Text
  servicesSectionTitle_id String? @db.VarChar(500)
  servicesSectionTitle_en String? @db.VarChar(500)
  servicesSectionDesc_id  String? @db.Text
  servicesSectionDesc_en  String? @db.Text

  updatedAt       DateTime @updatedAt

  @@map("sitesettings")
}
